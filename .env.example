# Sao chép file này thành ".env" rồi chỉnh lại cho phù hợp với máy của bạn.

# Chuỗi kết nối MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DBNAME=QLKhachHangThanThiet

# Cổng chạy web server
PORT=3000

# Khóa bí mật cho session đăng nhập (đổi thành chuỗi ngẫu nhiên khi triển khai thật)
SESSION_SECRET=qlkhachhangthanthiet-secret-2026

# Đường dẫn tới công cụ MongoDB Database Tools (nếu không có trong PATH thì ghi đường dẫn đầy đủ)
MONGODUMP_PATH=mongodump
MONGORESTORE_PATH=mongorestore
