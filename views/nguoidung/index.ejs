<%- include('../partials/layout-start', { title }) %>

<%
  function sortUrl(field) {
    var params = new URLSearchParams();
    if (q) params.set('q', q);
    var newOrder = (sortField === field && sortOrder === 1) ? 'desc' : 'asc';
    params.set('sort', field);
    params.set('order', newOrder);
    return '?' + params.toString();
  }
  function arrow(field) {
    return sortField === field ? '<span class="sort-arrow">' + (sortOrder === 1 ? '&#9650;' : '&#9660;') + '</span>' : '';
  }
%>

<div class="page-header">
  <div>
    <h1>Quản trị Người dùng hệ thống</h1>
    <p style="margin:4px 0 0; color:var(--text-muted); font-size:13px;">Phân quyền tài khoản Quản trị viên (Admin) và Nhân viên vận hành (Staff)</p>
  </div>
  <a href="/nguoi-dung/new" class="btn btn-primary">
    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
    <span>Thêm người dùng</span>
  </a>
</div>

<div class="card">
  <div class="toolbar">
    <form method="GET" action="/nguoi-dung">
      <input type="text" name="q" class="grow" placeholder="Tìm theo họ tên, tên đăng nhập, email..." value="<%= q %>">
      <button type="submit" class="btn btn-secondary">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
        <span>Tìm kiếm</span>
      </button>
      <% if (q) { %>
        <a href="/nguoi-dung" class="btn btn-secondary">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
          <span>Bỏ lọc</span>
        </a>
      <% } %>
    </form>
    <div style="font-size:13px; color:var(--text-muted); font-weight:600;">
      Tổng cộng: <strong style="color:var(--text-main);"><%= danhSach.length %></strong> tài khoản
    </div>
  </div>

  <div class="table-wrap">
    <table class="data-table">
      <thead>
        <tr>
          <th><a href="<%= sortUrl('_id') %>">Mã <%- arrow('_id') %></a></th>
          <th><a href="<%= sortUrl('HoTen') %>">Họ và tên <%- arrow('HoTen') %></a></th>
          <th><a href="<%= sortUrl('TenDangNhap') %>">Tên đăng nhập <%- arrow('TenDangNhap') %></a></th>
          <th>Email</th>
          <th><a href="<%= sortUrl('VaiTro') %>">Vai trò <%- arrow('VaiTro') %></a></th>
          <th><a href="<%= sortUrl('TrangThai') %>">Trạng thái <%- arrow('TrangThai') %></a></th>
          <th><a href="<%= sortUrl('NgayTao') %>">Ngày tạo <%- arrow('NgayTao') %></a></th>
          <th style="text-align:center;">Thao tác</th>
        </tr>
      </thead>
      <tbody>
        <% if (danhSach.length === 0) { %>
          <tr class="empty-row"><td colspan="8">Không có tài khoản nào phù hợp với từ khóa tìm kiếm.</td></tr>
        <% } %>
        <% danhSach.forEach(function(nd) { %>
          <tr>
            <td><strong style="color:var(--primary-700);"><%= nd._id %></strong></td>
            <td>
              <div style="display:flex; align-items:center; gap:10px;">
                <div style="width:28px; height:28px; border-radius:50%; background:<%= nd.VaiTro === 'Admin' ? 'var(--primary-100)' : 'var(--slate-100)' %>; color:<%= nd.VaiTro === 'Admin' ? 'var(--primary-700)' : 'var(--slate-700)' %>; display:flex; align-items:center; justify-content:center; font-weight:700; font-size:12px;">
                  <%= (nd.HoTen || '?').trim().charAt(0).toUpperCase() %>
                </div>
                <strong><%= nd.HoTen %></strong>
              </div>
            </td>
            <td><code><%= nd.TenDangNhap %></code></td>
            <td><%= nd.Email || '-' %></td>
            <td>
              <span class="badge <%= nd.VaiTro === 'Admin' ? 'badge-blue' : 'badge-gray' %>">
                <%= nd.VaiTro === 'Admin' ? '🛡️ Quản trị viên' : '👤 Nhân viên' %>
              </span>
            </td>
            <td>
              <% if (nd.TrangThai === 'HoatDong') { %>
                <span class="badge badge-success"><span class="badge-dot"></span> Đang hoạt động</span>
              <% } else { %>
                <span class="badge badge-gray"><span class="badge-dot"></span> Đã khóa</span>
              <% } %>
            </td>
            <td><%= nd.NgayTao %></td>
            <td class="actions" style="justify-content:center;">
              <a href="/nguoi-dung/<%= nd._id %>/edit" class="btn btn-sm btn-secondary" title="Sửa tài khoản">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/></svg>
                <span>Sửa</span>
              </a>
              <form class="form-confirm-delete" data-confirm="Xác nhận xóa tài khoản <%= nd.TenDangNhap %>?" method="POST" action="/nguoi-dung/<%= nd._id %>/delete" style="margin:0;">
                <button type="submit" class="btn btn-sm btn-danger" title="Xóa tài khoản">
                  <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>
                  <span>Xóa</span>
                </button>
              </form>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</div>

<%- include('../partials/layout-end') %>
