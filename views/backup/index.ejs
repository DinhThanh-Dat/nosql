<%- include('../partials/layout-start', { title }) %>

<div class="page-header">
  <div>
    <h1>Sao lưu &amp; Phục hồi Cơ sở dữ liệu</h1>
    <p style="margin:4px 0 0; color:var(--text-muted); font-size:13px;">Công cụ sao lưu CSDL mongodump / mongorestore và tính năng Import - Export dữ liệu JSON</p>
  </div>
</div>

<div class="card">
  <div class="page-header" style="margin-bottom:8px;">
    <h3>
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--primary-600)" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg>
      1) Sao lưu &amp; Phục hồi toàn bộ CSDL (mongodump / mongorestore)
    </h3>
  </div>
  <p style="color:var(--text-muted); font-size:13px; margin-bottom:20px;">
    Sử dụng bộ công cụ <strong>MongoDB Database Tools</strong> được cấu hình trong <code>.env</code> (đường dẫn máy chủ server).
  </p>

  <div style="display:grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap:24px;">
    <div style="background:var(--slate-50); border:1px solid var(--border); padding:20px; border-radius:var(--radius-md);">
      <h4 style="margin:0 0 12px; font-size:15px; color:var(--slate-900);">📦 Tạo bản sao lưu (Dump)</h4>
      <form method="POST" action="/sao-luu-phuc-hoi/mongodump">
        <div class="form-group">
          <label>Thư mục lưu bản sao lưu (đường dẫn tuyệt đối trên server)</label>
          <input type="text" name="thuMucDich" placeholder="VD: D:\backup\qlkhachhang" required>
        </div>
        <button type="submit" class="btn btn-primary" style="margin-top:10px;">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"/><polyline points="17 21 17 13 7 13 7 21"/><polyline points="7 3 7 8 15 8"/></svg>
          <span>Thực hiện Sao lưu</span>
        </button>
      </form>
    </div>

    <div style="background:var(--slate-50); border:1px solid var(--border); padding:20px; border-radius:var(--radius-md);">
      <h4 style="margin:0 0 12px; font-size:15px; color:var(--danger-text);">⚠️ Phục hồi CSDL (Restore)</h4>
      <form method="POST" action="/sao-luu-phuc-hoi/mongorestore">
        <div class="form-group">
          <label>Thư mục chứa bản sao lưu cần phục hồi</label>
          <input type="text" name="thuMucNguon" placeholder="VD: D:\backup\qlkhachhang" required>
        </div>
        <button type="submit" class="btn btn-danger" style="margin-top:10px;"
          onclick="return confirm('CẢNH BÁO NGUY HIỂM: Phục hồi sẽ GHI ĐÈ (--drop) toàn bộ dữ liệu hiện tại trong MongoDB. Bạn có chắc chắn muốn tiếp tục?');">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 12a9 9 0 0 1 9-9 9.75 9.75 0 0 1 6.74 2.74L21 8"/><path d="M21 3v5h-5"/><path d="M21 12a9 9 0 0 1-9 9 9.75 9.75 0 0 1-6.74-2.74L3 16"/><path d="M3 21v-5h5"/></svg>
          <span>Thực hiện Phục hồi</span>
        </button>
      </form>
    </div>
  </div>
</div>

<div class="card">
  <div class="page-header" style="margin-bottom:8px;">
    <h3>
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--primary-600)" stroke-width="2"><polyline points="16 16 12 12 8 16"/><line x1="12" y1="12" x2="12" y2="21"/><path d="M20.39 18.39A5 5 0 0 0 18 9h-1.26A8 8 0 1 0 3 16.3"/><polyline points="16 16 12 12 8 16"/></svg>
      2) Import / Export theo từng Collection (Định dạng JSON)
    </h3>
  </div>
  <p style="color:var(--text-muted); font-size:13px; margin-bottom:20px;">
    Sử dụng trực tiếp Node.js MongoDB Driver độc lập, không phụ thuộc vào công cụ command line ngoài máy.
  </p>

  <div style="display:grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap:24px;">
    <div style="background:var(--slate-50); border:1px solid var(--border); padding:20px; border-radius:var(--radius-md);">
      <h4 style="margin:0 0 12px; font-size:15px; color:var(--slate-900);">📤 Xuất dữ liệu (Export)</h4>
      <form method="GET" action="#" onsubmit="event.preventDefault(); window.location = '/sao-luu-phuc-hoi/export/' + this.collection.value;">
        <div class="form-group">
          <label>Chọn Collection cần xuất dữ liệu</label>
          <select name="collection">
            <% danhSachCollection.forEach(function(c) { %><option value="<%= c %>"><%= c %></option><% }) %>
          </select>
        </div>
        <button type="submit" class="btn btn-secondary" style="margin-top:10px;">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
          <span>Tải file JSON về máy</span>
        </button>
      </form>
    </div>

    <div style="background:var(--slate-50); border:1px solid var(--border); padding:20px; border-radius:var(--radius-md);">
      <h4 style="margin:0 0 12px; font-size:15px; color:var(--slate-900);">📥 Nhập dữ liệu (Import)</h4>
      <form method="POST" action="/sao-luu-phuc-hoi/import/KhachHang" onsubmit="this.action = '/sao-luu-phuc-hoi/import/' + this.collectionSelect.value;">
        <div class="form-group">
          <label>Chọn Collection cần nạp dữ liệu</label>
          <select name="collectionSelect">
            <% danhSachCollection.forEach(function(c) { %><option value="<%= c %>"><%= c %></option><% }) %>
          </select>
        </div>
        <div class="form-group">
          <label>Đường dẫn file JSON (trên server)</label>
          <input type="text" name="duongDanFile" placeholder="VD: D:\backup\KhachHang.json" required>
        </div>
        <label class="checkbox-row" style="margin-top:4px;">
          <input type="checkbox" name="xoaDuLieuCu">
          <span>Xóa dữ liệu cũ trong collection trước khi nạp</span>
        </label>
        <div style="margin-top:12px;">
          <button type="submit" class="btn btn-secondary">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg>
            <span>Thực hiện Import</span>
          </button>
        </div>
      </form>
    </div>
  </div>
</div>

<div class="card" style="border-left: 4px solid var(--warning);">
  <div class="page-header" style="margin-bottom:8px;">
    <h3>
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--warning)" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
      3) Khôi phục dữ liệu mẫu ban đầu (Sample Data Reset)
    </h3>
  </div>
  <p style="color:var(--text-muted); font-size:13px; margin-bottom:16px;">
    Thao tác này sẽ đặt lại môi trường demo về trạng thái ban đầu của đề tài (nạp lại 7 file JSON gốc trong thư mục <code>SampleData/</code>).
  </p>
  <form method="POST" action="/sao-luu-phuc-hoi/nhap-du-lieu-mau"
        onsubmit="return confirm('CẢNH BÁO: XÓA TOÀN BỘ dữ liệu hiện tại trong 7 Collection và nạp lại dữ liệu mẫu gốc?');">
    <button type="submit" class="btn btn-danger">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 4v6h6"/><path d="M3.51 15a9 9 0 1 0 2.13-9.36L1 10"/></svg>
      <span>Đặt lại dữ liệu mẫu ban đầu</span>
    </button>
  </form>
</div>

<% if (typeof log !== 'undefined' && log) { %>
<div class="card">
  <h3>Nhật ký thực thi gần nhất</h3>
  <pre class="code-box"><%= log %></pre>
</div>
<% } %>

<%- include('../partials/layout-end') %>
