<%- include('../partials/layout-start', { title }) %>

<%
  function sortUrl(field) {
    var params = new URLSearchParams();
    if (maKhachHang) params.set('maKhachHang', maKhachHang);
    if (trangThai) params.set('trangThai', trangThai);
    var newOrder = (sortField === field && sortOrder === 1) ? 'desc' : 'asc';
    params.set('sort', field);
    params.set('order', newOrder);
    return '?' + params.toString();
  }
  function arrow(field) {
    return sortField === field ? '<span class="sort-arrow">' + (sortOrder === 1 ? '&#9650;' : '&#9660;') + '</span>' : '';
  }
%>

<div class="page-header">
  <div>
    <h1>Quản lý Giao dịch</h1>
    <p style="margin:4px 0 0; color:var(--text-muted); font-size:13px;">Theo dõi đơn mua hàng, thanh toán và cơ chế tích lũy điểm tự động</p>
  </div>
  <a href="/giao-dich/new" class="btn btn-primary">
    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
    <span>Tạo giao dịch</span>
  </a>
</div>

<div class="card">
  <div class="toolbar">
    <form method="GET" action="/giao-dich">
      <select name="maKhachHang" style="min-width:220px;">
        <option value="">-- Tất cả khách hàng --</option>
        <% dsKhachHang.forEach(function(kh) { %>
          <option value="<%= kh._id %>" <%= maKhachHang === kh._id ? 'selected' : '' %>><%= kh._id %> - <%= kh.HoTen %></option>
        <% }) %>
      </select>
      <select name="trangThai">
        <option value="">-- Tất cả trạng thái --</option>
        <option value="HoanTat" <%= trangThai === 'HoanTat' ? 'selected' : '' %>>Hoàn tất</option>
        <option value="DangXuLy" <%= trangThai === 'DangXuLy' ? 'selected' : '' %>>Đang xử lý</option>
        <option value="Huy" <%= trangThai === 'Huy' ? 'selected' : '' %>>Hủy</option>
      </select>
      <button type="submit" class="btn btn-secondary">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="22 3 2 3 10 12.46 10 19 14 21 14 12.46 22 3"/></svg>
        <span>Lọc dữ liệu</span>
      </button>
      <% if (maKhachHang || trangThai) { %>
        <a href="/giao-dich" class="btn btn-secondary">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
          <span>Bỏ lọc</span>
        </a>
      <% } %>
    </form>
    <div style="font-size:13px; color:var(--text-muted); font-weight:600;">
      Tìm thấy: <strong style="color:var(--text-main);"><%= danhSach.length %></strong> giao dịch
    </div>
  </div>

  <div class="table-wrap">
    <table class="data-table">
      <thead>
        <tr>
          <th><a href="<%= sortUrl('_id') %>">Mã GD <%- arrow('_id') %></a></th>
          <th><a href="<%= sortUrl('MaKhachHang') %>">Khách hàng <%- arrow('MaKhachHang') %></a></th>
          <th><a href="<%= sortUrl('NgayGiaoDich') %>">Ngày GD <%- arrow('NgayGiaoDich') %></a></th>
          <th>Loại GD</th>
          <th style="text-align:right;"><a href="<%= sortUrl('TongTien') %>">Tổng tiền <%- arrow('TongTien') %></a></th>
          <th style="text-align:right;"><a href="<%= sortUrl('DiemNhan') %>">Điểm nhận <%- arrow('DiemNhan') %></a></th>
          <th>Thanh toán</th>
          <th>Chi nhánh</th>
          <th><a href="<%= sortUrl('TrangThai') %>">Trạng thái <%- arrow('TrangThai') %></a></th>
          <th style="text-align:center;">Thao tác</th>
        </tr>
      </thead>
      <tbody>
        <% if (danhSach.length === 0) { %>
          <tr class="empty-row"><td colspan="10">Không có giao dịch nào phù hợp với bộ lọc.</td></tr>
        <% } %>
        <% danhSach.forEach(function(gd) { %>
          <tr>
            <td><strong style="color:var(--primary-700);"><%= gd._id %></strong></td>
            <td><span class="badge badge-gray"><%= gd.MaKhachHang %></span></td>
            <td><%= gd.NgayGiaoDich %></td>
            <td><%= gd.LoaiGiaoDich === 'MuaHang' ? 'Mua hàng' : 'Trả hàng' %></td>
            <td class="num" style="color:var(--primary-700); font-weight:700;"><%= Number(gd.TongTien).toLocaleString('vi-VN') %> đ</td>
            <td class="num" style="color:var(--success-text); font-weight:700;">+<%= gd.DiemNhan %></td>
            <td><%= gd.PhuongThucThanhToan %></td>
            <td><%= gd.ChiNhanh %></td>
            <td>
              <% if (gd.TrangThai === 'HoanTat') { %>
                <span class="badge badge-success"><span class="badge-dot"></span> Hoàn tất</span>
              <% } else if (gd.TrangThai === 'DangXuLy') { %>
                <span class="badge badge-warning"><span class="badge-dot"></span> Đang xử lý</span>
              <% } else { %>
                <span class="badge badge-danger"><span class="badge-dot"></span> Đã hủy</span>
              <% } %>
            </td>
            <td class="actions" style="justify-content:center;">
              <a href="/giao-dich/<%= gd._id %>/edit" class="btn btn-sm btn-secondary" title="Sửa giao dịch">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/></svg>
                <span>Sửa</span>
              </a>
              <form class="form-confirm-delete" data-confirm="Xác nhận xóa giao dịch <%= gd._id %>? Lưu ý: Điểm đã tích lũy sẽ không tự động hoàn tác." method="POST" action="/giao-dich/<%= gd._id %>/delete" style="margin:0;">
                <button type="submit" class="btn btn-sm btn-danger" title="Xóa giao dịch">
                  <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>
                  <span>Xóa</span>
                </button>
              </form>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</div>

<%- include('../partials/layout-end') %>
