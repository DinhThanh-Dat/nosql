<%
  function isActive(prefix) {
    return typeof currentPath !== 'undefined' && currentPath.indexOf(prefix) === 0 ? 'active' : '';
  }
%>
<aside class="sidebar">
  <div class="sidebar-brand">
    <img src="/img/logo.svg" alt="Logo">
    <div class="brand-text">
      LOYALTY CRM <span class="brand-pill">v1.0</span>
      <small>MongoDB &amp; Node.js Solution</small>
    </div>
  </div>

  <div class="sidebar-section-label">Tổng quan</div>
  <ul class="sidebar-nav">
    <li>
      <a href="/dashboard" class="<%= isActive('/dashboard') %>">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7" rx="1.5"/><rect x="14" y="3" width="7" height="7" rx="1.5"/><rect x="3" y="14" width="7" height="7" rx="1.5"/><rect x="14" y="14" width="7" height="7" rx="1.5"/></svg>
        Bảng điều khiển
      </a>
    </li>
  </ul>

  <div class="sidebar-section-label">Nghiệp vụ cốt lõi</div>
  <ul class="sidebar-nav">
    <li>
      <a href="/khach-hang" class="<%= isActive('/khach-hang') %>">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="8" r="4"/><path d="M4 21c0-4.4 3.6-7 8-7s8 2.6 8 7"/></svg>
        Khách hàng
      </a>
    </li>
    <li>
      <a href="/hang-thanh-vien" class="<%= isActive('/hang-thanh-vien') %>">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 3l2.6 5.3 5.8.8-4.2 4.1 1 5.8L12 16.9 6.8 19l1-5.8L3.6 9.1l5.8-.8z"/></svg>
        Hạng thành viên
      </a>
    </li>
    <li>
      <a href="/giao-dich" class="<%= isActive('/giao-dich') %>">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h2l1.2 12.4A2 2 0 0 0 9.2 18h8.1a2 2 0 0 0 2-1.6L21 8H6"/><circle cx="10" cy="21" r="1"/><circle cx="17" cy="21" r="1"/></svg>
        Giao dịch
      </a>
    </li>
    <li>
      <a href="/diem-tich-luy" class="<%= isActive('/diem-tich-luy') %>">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="9"/><path d="M9 12l2 2 4-4.5"/></svg>
        Điểm tích lũy
      </a>
    </li>
    <li>
      <a href="/uu-dai" class="<%= isActive('/uu-dai') %>">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="8" width="18" height="13" rx="1.5"/><path d="M3 12h18M12 8v13"/><path d="M12 8c-1.5 0-3-1-3-2.5S10.3 3 12 4c1.7-1 3 0 3 1.5S13.5 8 12 8z"/></svg>
        Kho ưu đãi
      </a>
    </li>
    <li>
      <a href="/su-dung-uu-dai" class="<%= isActive('/su-dung-uu-dai') %>">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 12l-8 8-9-9V4h7z"/><circle cx="7.5" cy="7.5" r="1.2"/></svg>
        Lịch sử đổi ưu đãi
      </a>
    </li>
  </ul>

  <div class="sidebar-section-label">Phân tích chuyên sâu</div>
  <ul class="sidebar-nav">
    <li>
      <a href="/truy-van" class="<%= isActive('/truy-van') %>">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"/><path d="M21 21l-4.3-4.3"/></svg>
        15 câu truy vấn NoSQL
      </a>
    </li>
  </ul>

  <% if (typeof currentUser !== 'undefined' && currentUser && currentUser.VaiTro === 'Admin') { %>
  <div class="sidebar-section-label">Quản trị &amp; CSDL</div>
  <ul class="sidebar-nav">
    <li>
      <a href="/nguoi-dung" class="<%= isActive('/nguoi-dung') %>">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="9" cy="8" r="3.2"/><path d="M3 20c0-3.6 2.7-5.8 6-5.8s6 2.2 6 5.8"/><path d="M16.5 7.5a2.6 2.6 0 1 1 0 5.2M20 20c0-2.8-1.7-4.7-3.8-5.4"/></svg>
        Quản lý người dùng
      </a>
    </li>
    <li>
      <a href="/sao-luu-phuc-hoi" class="<%= isActive('/sao-luu-phuc-hoi') %>">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="5" rx="1"/><path d="M5 9v9a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V9"/><path d="M10 13h4"/></svg>
        Sao lưu &amp; Phục hồi
      </a>
    </li>
  </ul>
  <% } %>

  <div class="sidebar-footer">
    <div class="sidebar-status-card">
      <span class="status-indicator-dot"></span>
      <div class="sidebar-status-info">
        <strong>MongoDB Online</strong>
        Đề tài NoSQL · Nhóm 5
      </div>
    </div>
  </div>
</aside>
