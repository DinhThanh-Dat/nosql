<%- include('../partials/layout-start', { title }) %>

<%
  // Thu thập toàn bộ tên cột xuất hiện trong kết quả (mỗi câu truy vấn trả về hình dạng khác nhau)
  var cotHienThi = [];
  ketQua.forEach(function (doc) {
    if (doc && typeof doc === 'object') {
      Object.keys(doc).forEach(function (k) {
        if (cotHienThi.indexOf(k) === -1) cotHienThi.push(k);
      });
    }
  });

  function hienThiGiaTri(v) {
    if (v === null || v === undefined) return '';
    if (typeof v === 'object') {
      if (Array.isArray(v)) return v.length + ' phần tử';
      return JSON.stringify(v);
    }
    if (typeof v === 'number') return v.toLocaleString('vi-VN');
    return String(v);
  }
%>

<div class="page-header">
  <div>
    <h1>15 Câu truy vấn MongoDB Aggregation &amp; CRUD</h1>
    <p style="margin:4px 0 0; color:var(--text-muted); font-size:13px;">Thực thi và minh họa các câu truy vấn thuộc Chương 3 đề tài tiểu luận NoSQL</p>
  </div>
</div>

<div class="card">
  <form method="GET" action="/truy-van" class="toolbar" style="gap:14px; margin-bottom:20px;">
    <div class="form-group grow" style="min-width:340px;">
      <label style="font-weight:700; color:var(--slate-800);">Chọn câu truy vấn để thực thi:</label>
      <select name="q" onchange="this.form.submit()" style="font-size:14px; font-weight:500; border-color:var(--primary-300);">
        <% danhSach.forEach(function(c) { %>
          <option value="<%= c.ma %>" <%= cauTruyVan.ma === c.ma ? 'selected' : '' %>>
            Câu <%= c.stt %>. <%= c.moTa %> [<%= c.mucDo %>]
          </option>
        <% }) %>
      </select>
    </div>
    <noscript><button type="submit" class="btn btn-secondary">Xem</button></noscript>
  </form>

  <div style="display:grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap:14px; margin-bottom:18px;">
    <div style="background:var(--slate-50); border:1px solid var(--border); padding:12px 16px; border-radius:var(--radius-sm);">
      <span style="font-size:11.5px; color:var(--text-muted); text-transform:uppercase; font-weight:700; display:block;">Target Collection</span>
      <strong style="font-size:15px; color:var(--primary-700); font-family:monospace;"><%= cauTruyVan.collection %></strong>
    </div>
    <div style="background:var(--slate-50); border:1px solid var(--border); padding:12px 16px; border-radius:var(--radius-sm);">
      <span style="font-size:11.5px; color:var(--text-muted); text-transform:uppercase; font-weight:700; display:block;">Mức độ phức tạp</span>
      <span class="badge <%= cauTruyVan.mucDo === 'Nâng cao' ? 'badge-blue' : 'badge-gray' %>" style="margin-top:2px;">
        <span class="badge-dot"></span> <%= cauTruyVan.mucDo %>
      </span>
    </div>
    <div style="background:var(--slate-50); border:1px solid var(--border); padding:12px 16px; border-radius:var(--radius-sm);">
      <span style="font-size:11.5px; color:var(--text-muted); text-transform:uppercase; font-weight:700; display:block;">Số dòng kết quả</span>
      <strong style="font-size:15px; color:var(--slate-900);"><%= ketQua.length %> bản ghi</strong>
    </div>
  </div>

  <label style="font-weight:700; color:var(--slate-800); font-size:13px; display:flex; align-items:center; justify-content:space-between;">
    <span>Pipeline / Cú pháp MongoDB Shell:</span>
  </label>
  
  <div class="query-inspector">
    <div class="query-inspector-header">
      <div class="mac-dots">
        <span class="mac-dot red"></span>
        <span class="mac-dot yellow"></span>
        <span class="mac-dot green"></span>
      </div>
      <span class="query-inspector-title">mongosh — <%= cauTruyVan.collection %></span>
      <button type="button" class="btn btn-sm btn-secondary" id="btn-copy-query" style="padding:2px 8px; font-size:11px; background:rgba(255,255,255,0.08); border-color:rgba(255,255,255,0.15); color:#cbd5e1;">
        Copy code
      </button>
    </div>
    <pre class="code-box" id="pipeline-code"><%= cauTruyVan.pipeline %></pre>
  </div>

  <h3 style="margin-top:28px; margin-bottom:12px;">
    Kết quả thực thi từ CSDL
    <span class="badge badge-gray"><%= ketQua.length %> dòng</span>
  </h3>
  <div class="table-wrap">
    <table class="data-table">
      <thead>
        <tr>
          <% cotHienThi.forEach(function(c) { %><th><%= c %></th><% }) %>
        </tr>
      </thead>
      <tbody>
        <% if (ketQua.length === 0) { %>
          <tr class="empty-row"><td colspan="<%= cotHienThi.length || 1 %>">Truy vấn không trả về bản ghi nào.</td></tr>
        <% } %>
        <% ketQua.forEach(function(doc) { %>
          <tr>
            <% cotHienThi.forEach(function(c) { %>
              <td class="<%= typeof doc[c] === 'number' ? 'num' : '' %>">
                <%= hienThiGiaTri(doc[c]) %>
              </td>
            <% }) %>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</div>

<%- include('../partials/layout-end') %>
