<%- include('../partials/layout-start', { title }) %>

<%
  function sortUrl(field) {
    var params = new URLSearchParams();
    var newOrder = (sortField === field && sortOrder === 1) ? 'desc' : 'asc';
    params.set('sort', field);
    params.set('order', newOrder);
    return '?' + params.toString();
  }
  function arrow(field) {
    return sortField === field ? '<span class="sort-arrow">' + (sortOrder === 1 ? '&#9650;' : '&#9660;') + '</span>' : '';
  }
%>

<div class="page-header">
  <div>
    <h1>Chính sách Hạng thành viên</h1>
    <p style="margin:4px 0 0; color:var(--text-muted); font-size:13px;">Thiết lập cấp bậc tích lũy điểm và định mức tỷ lệ ưu đãi tương ứng</p>
  </div>
  <a href="/hang-thanh-vien/new" class="btn btn-primary">
    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
    <span>Thêm hạng thành viên</span>
  </a>
</div>

<div class="card">
  <div class="table-wrap">
    <table class="data-table">
      <thead>
        <tr>
          <th><a href="<%= sortUrl('_id') %>">Mã <%- arrow('_id') %></a></th>
          <th><a href="<%= sortUrl('TenHang') %>">Tên hạng <%- arrow('TenHang') %></a></th>
          <th style="text-align:right;"><a href="<%= sortUrl('DiemToiThieu') %>">Điểm tối thiểu <%- arrow('DiemToiThieu') %></a></th>
          <th style="text-align:right;"><a href="<%= sortUrl('DiemToiDa') %>">Điểm tối đa <%- arrow('DiemToiDa') %></a></th>
          <th style="text-align:right;"><a href="<%= sortUrl('TyLeUuDai') %>">Tỷ lệ chiết khấu <%- arrow('TyLeUuDai') %></a></th>
          <th>Mô tả quyền lợi</th>
          <th style="text-align:center;">Thao tác</th>
        </tr>
      </thead>
      <tbody>
        <% if (danhSach.length === 0) { %>
          <tr class="empty-row"><td colspan="7">Chưa có hạng thành viên nào được thiết lập.</td></tr>
        <% } %>
        <% danhSach.forEach(function(h) { %>
          <tr>
            <td><strong style="color:var(--primary-700);"><%= h._id %></strong></td>
            <td>
              <span class="badge badge-blue" style="font-size:13px; font-weight:700;">
                <%= h.TenHang %>
              </span>
            </td>
            <td class="num" style="font-weight:600;"><%= h.DiemToiThieu.toLocaleString('vi-VN') %></td>
            <td class="num" style="font-weight:600;"><%= h.DiemToiDa != null ? h.DiemToiDa.toLocaleString('vi-VN') : '∞ (Vô cực)' %></td>
            <td class="num" style="color:var(--success-text); font-weight:700;"><%= h.TyLeUuDai %>%</td>
            <td style="color:var(--slate-600);"><%= h.MoTa %></td>
            <td class="actions" style="justify-content:center;">
              <a href="/hang-thanh-vien/<%= h._id %>/edit" class="btn btn-sm btn-secondary" title="Sửa quyền lợi">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/></svg>
                <span>Sửa</span>
              </a>
              <form class="form-confirm-delete" data-confirm="Xác nhận xóa hạng <%= h.TenHang %>?" method="POST" action="/hang-thanh-vien/<%= h._id %>/delete" style="margin:0;">
                <button type="submit" class="btn btn-sm btn-danger" title="Xóa hạng này">
                  <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>
                  <span>Xóa</span>
                </button>
              </form>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</div>

<%- include('../partials/layout-end') %>
